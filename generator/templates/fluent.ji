namespace LoreVcs;

using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Collections.Immutable;
using System.Runtime.ExceptionServices;
using System.Threading.Channels;
using System.Threading.Tasks;
using System.Threading;
using LoreVcs.Types;
using LoreVcs.Types.Args;
using LoreVcs.Types.Enums;
using LoreVcs.Types.Events;
using static LoreVcs.Interop.Native;

public delegate int LoreFunction<LoreArgs>(in LoreGlobalArgs globalArgs, in LoreArgs args, LoreEventCallbackConfig callback);
public delegate TaskCompletionSource<int> LoreFunctionAsync<LoreArgs>(in LoreGlobalArgs globalArgs, in LoreArgs args, LoreEventCallbackConfig callback);

/// <summary>
/// Thrown when a Lore operation finishes with a non-zero return code. The
/// message is built from the ERROR events emitted during the operation,
/// falling back to the failed COMPLETE event's error message when no ERROR
/// event was emitted, so an explicit error always takes precedence.
/// </summary>
public sealed class LoreError : Exception
{
    public int ReturnCode { get; }
    public IReadOnlyList<string> Messages { get; }

    public LoreError(int returnCode, IReadOnlyList<string>? messages = null)
        : base(BuildMessage(returnCode, messages))
    {
        ReturnCode = returnCode;
        Messages = messages ?? Array.Empty<string>();
    }

    private static string BuildMessage(int returnCode, IReadOnlyList<string>? messages)
    {
        if (messages != null && messages.Count > 0)
        {
            return $"Lore operation failed with code {returnCode}: {string.Join("; ", messages)}";
        }
        return $"Lore operation failed with code {returnCode}";
    }
}

/// <summary>
/// Accumulates error context from the terminal events of a Lore operation: the
/// message of every ERROR event, and the error message of a failed COMPLETE
/// event (non-zero status). The COMPLETE message is only surfaced when no ERROR
/// event was recorded, so an explicit error always takes precedence.
///
/// Recording happens on a lorelib worker thread while the calling thread reads
/// the result, so both sides take the lock.
/// </summary>
internal sealed class TerminalEventRecorder
{
    private readonly object gate = new();
    private readonly List<string> errorMessages = new();
    private string? completeError;

    public void Record(LoreEventFFI loreEvent)
    {
        if (loreEvent.Tag == LoreEventTag.ERROR)
        {
            var message = loreEvent.GetData<LoreErrorEventDataFFI>().ErrorInner;
            lock (gate)
            {
                errorMessages.Add(message);
            }
        }
        else if (loreEvent.Tag == LoreEventTag.COMPLETE)
        {
            var data = loreEvent.GetData<LoreCompleteEventDataFFI>();
            if (data.Status != 0)
            {
                var message = data.Error.Message;
                lock (gate)
                {
                    completeError = message;
                }
            }
        }
    }

    // ERROR event messages take precedence; otherwise fall back to the failed
    // COMPLETE event's error message when one was recorded.
    public IReadOnlyList<string> Messages()
    {
        lock (gate)
        {
            if (errorMessages.Count > 0)
            {
                return new List<string>(errorMessages);
            }
            if (!string.IsNullOrEmpty(completeError))
            {
                return new List<string> { completeError };
            }
            return Array.Empty<string>();
        }
    }
}

public sealed class LoreExecutor<LoreArgs>
{
    private LoreGlobalArgs globalArgs;
    private LoreArgs args;
    private LoreFunction<LoreArgs> function;
    private LoreFunctionAsync<LoreArgs> functionAsync;
    private LoreCallback callback = (LoreEventFFI loreEvent, ulong userContext) => {};
    private HashSet<LoreEventTag> filterTags = new();
    private readonly object gate = new();
    private List<LoreEvent> collectedEvents = new();
    private Channel<LoreEvent> channel;
    private ulong userContext;
    private bool terminated;
    private TerminalEventRecorder recorder = new();
    private Exception? callbackException;

    private bool Accepts(LoreEventTag tag) => filterTags.Count == 0 || filterTags.Contains(tag);

    // The event handlers run on a lorelib worker thread, which must not have a
    // managed exception unwind through it. The first failure is kept and
    // rethrown from the terminal method, on the calling thread.
    private void RecordCallbackException(Exception exception)
    {
        Interlocked.CompareExchange(ref callbackException, exception, null);
    }

    private void ThrowIfCallbackFailed()
    {
        var exception = Volatile.Read(ref callbackException);
        if (exception != null)
        {
            ExceptionDispatchInfo.Capture(exception).Throw();
        }
    }

    private void WaitEventHandler(LoreEventFFI loreEvent, ulong userContext)
    {
        try
        {
            Lore.HandleGlobalCallbackEvent(loreEvent, userContext);
            recorder.Record(loreEvent);
            if (Accepts(loreEvent.Tag))
            {
                callback(loreEvent, userContext);
            }
        }
        catch (Exception exception)
        {
            RecordCallbackException(exception);
        }
    }

    private void CollectEventHandler(LoreEventFFI loreEvent, ulong userContext)
    {
        try
        {
            Lore.HandleGlobalCallbackEvent(loreEvent, userContext);
            recorder.Record(loreEvent);
            if (Accepts(loreEvent.Tag))
            {
                callback(loreEvent, userContext);

                var collected = loreEvent.Clone();
                lock (gate)
                {
                    collectedEvents.Add(collected);
                }
            }
        }
        catch (Exception exception)
        {
            RecordCallbackException(exception);
        }
    }

    private void AsyncIterEventHandler(LoreEventFFI loreEvent, ulong userContext)
    {
        // Read the tag up front: the channel has to be completed on END even if
        // the callback below throws, or the enumerator never finishes.
        var tag = loreEvent.Tag;
        try
        {
            Lore.HandleGlobalCallbackEvent(loreEvent, userContext);
            recorder.Record(loreEvent);
            if (Accepts(tag))
            {
                callback(loreEvent, userContext);

                channel.Writer.TryWrite(loreEvent.Clone());
            }
        }
        catch (Exception exception)
        {
            RecordCallbackException(exception);
        }
        finally
        {
            if (tag == LoreEventTag.END)
            {
                channel.Writer.Complete();
            }
        }
    }

    private List<LoreEvent> SnapshotCollectedEvents()
    {
        lock (gate)
        {
            return new List<LoreEvent>(collectedEvents);
        }
    }

    public LoreExecutor(LoreGlobalArgs globalArgs, LoreArgs args, LoreFunction<LoreArgs> function, LoreFunctionAsync<LoreArgs> functionAsync)
    {
        this.globalArgs = globalArgs;
        this.args = args;
        this.function = function;
        this.functionAsync = functionAsync;
        this.channel = Channel.CreateUnbounded<LoreEvent>();
    }

    private void VerifyTermination()
    {
        if(terminated)
        {
            throw new InvalidOperationException("Already started");
        }
    }

    private void RaiseIfError(int returnCode)
    {
        if (returnCode != 0)
        {
            throw new LoreError(returnCode, recorder.Messages());
        }
    }

    public LoreExecutor<LoreArgs> Callback(LoreCallback callback)
    {
        this.callback = callback;
        return this;
    }

    public LoreExecutor<LoreArgs> FilterByType(LoreEventTag[] filterTags)
    {
        this.filterTags = new HashSet<LoreEventTag>(filterTags);
        return this;
    }

    public LoreExecutor<LoreArgs> UserContext(ulong userContext)
    {
        this.userContext = userContext;
        return this;
    }

    /// <summary>
    /// Runs the operation and returns once lorelib has dispatched its last
    /// event (END). Events are delivered on a lorelib worker thread.
    /// </summary>
    public int Wait()
    {
        VerifyTermination();
        terminated = true;
        recorder = new TerminalEventRecorder();
        var callback = new LoreEventCallbackConfig { UserContext = userContext, Func = WaitEventHandler };
        var returnCode = function(globalArgs, args, callback);
        ThrowIfCallbackFailed();
        RaiseIfError(returnCode);
        return returnCode;
    }

    /// <summary>
    /// Runs the operation and completes once lorelib has dispatched its last
    /// event (END), so no event can arrive after the await returns. A function
    /// whose callback stays registered past COMPLETE is the exception, such as
    /// NotificationSubscribe: it completes as soon as the subscription is
    /// established and keeps delivering events to the callback afterwards.
    /// </summary>
    public async Task<int> WaitAsync()
    {
        VerifyTermination();
        terminated = true;
        recorder = new TerminalEventRecorder();
        var callback = new LoreEventCallbackConfig { UserContext = userContext, Func = WaitEventHandler };
        // functionAsync starts the operation eagerly (so multiple WaitAsync()
        // calls run concurrently); awaiting its Task yields the return code.
        var returnCode = await functionAsync(globalArgs, args, callback).Task;
        ThrowIfCallbackFailed();
        RaiseIfError(returnCode);
        return returnCode;
    }

    public async IAsyncEnumerable<LoreEvent> AsyncIter()
    {
        VerifyTermination();
        terminated = true;
        recorder = new TerminalEventRecorder();
        var callback = new LoreEventCallbackConfig { UserContext = userContext, Func = AsyncIterEventHandler };
        var taskCompletionSource = functionAsync(globalArgs, args, callback);
        // A source already faulted on return means the call never reached
        // lorelib, so no event will ever arrive to complete the channel.
        if (taskCompletionSource.Task.IsFaulted)
        {
            await taskCompletionSource.Task;
        }
        await foreach (var ev in channel.Reader.ReadAllAsync())
        {
            yield return ev;
        }
        // The channel completed (END): surface a non-zero completion as an error.
        var returnCode = await taskCompletionSource.Task;
        ThrowIfCallbackFailed();
        RaiseIfError(returnCode);
    }

    /// <summary>
    /// Runs the operation and returns every event it dispatched, including the
    /// terminal COMPLETE and END events. Not meaningful for a function whose
    /// callback stays registered past COMPLETE, such as NotificationSubscribe:
    /// the events it dispatches after COMPLETE are not part of the result. Use
    /// <see cref="AsyncIter"/> to stream those.
    /// </summary>
    public List<LoreEvent> Collect()
    {
        VerifyTermination();
        terminated = true;
        recorder = new TerminalEventRecorder();

        collectedEvents.Clear();
        var callback = new LoreEventCallbackConfig { UserContext = userContext, Func = CollectEventHandler };
        var returnCode = function(globalArgs, args, callback);
        ThrowIfCallbackFailed();
        RaiseIfError(returnCode);
        return SnapshotCollectedEvents();
    }

    /// <summary>
    /// Runs the operation and returns every event it dispatched, including the
    /// terminal COMPLETE and END events. See <see cref="Collect"/> for the one
    /// kind of function this is not meaningful for.
    /// </summary>
    public async Task<List<LoreEvent>> CollectAsync()
    {
        VerifyTermination();
        terminated = true;
        recorder = new TerminalEventRecorder();

        collectedEvents.Clear();
        var callback = new LoreEventCallbackConfig { UserContext = userContext, Func = CollectEventHandler };
        var returnCode = await functionAsync(globalArgs, args, callback).Task;
        ThrowIfCallbackFailed();
        RaiseIfError(returnCode);
        return SnapshotCollectedEvents();
    }
}

public sealed class Lore
{
    private static readonly ConcurrentDictionary<LoreEventTag, ImmutableArray<LoreCallback>> event_subscriptions_by_event_type = new();

    // Creation methods
    {% for name, _ in symbols.functions.items() %}
        {% if "async" not in name %}
            {% set function_name = pascal_case(name)%}
            {% set function_args = function_name + "Args" %}
            {% if name not in uncommon_functions %}
            {% if name in symbols.functions_comments %}
    /**
    * <summary>
    * {{ "\n    * ".join(symbols.functions_comments[name]).replace("<", "&lt;").replace(">", "&gt;") }}
    * </summary>
    */
            {% endif %}
    public static LoreExecutor<{{ function_args }}> {{ function_name.removeprefix("Lore") }}(LoreGlobalArgs globalArgs, {{ function_args }} args)
    {
        return new LoreExecutor<{{ function_args }}>(globalArgs, args, {{ function_name }}, {{ function_name }}Async);
    }
            {% endif %}
        {% endif %}
    {% endfor %}

    public static void LogConfigure(LoreLogConfig logConfig)
    {
        var result = LoreLogConfigure(logConfig);
        if (result != 0) {
            throw new LoreError(result);
        }
    }

    public static int SetThreadLimit(nuint count)
    {
        return LoreSetThreadLimit(count);
    }

    public static int SetCompressionMode(LoreCompressionMode mode)
    {
        return LoreSetCompressionMode(mode);
    }

    public static int SetCompressionLevel(int level)
    {
        return LoreSetCompressionLevel(level);
    }

    public static void Shutdown()
    {
        var result = LoreShutdown();
        if (result != 0) {
            throw new LoreError(result);
        }
    }

    public static IDisposable GlobalCallback(LoreEventTag event_type, LoreCallback callback)
    {
        event_subscriptions_by_event_type.AddOrUpdate(
            event_type,
            _ => ImmutableArray.Create(callback),
            (_, arr) => arr.Add(callback)
        );

        return new Subscription(() => UnsubscribeGlobalCallback(event_type, callback));
    }

    private static void UnsubscribeGlobalCallback(LoreEventTag event_type, LoreCallback callback)
    {
        if (!event_subscriptions_by_event_type.TryGetValue(event_type, out _))
            return;

        event_subscriptions_by_event_type.AddOrUpdate(
            event_type,
            // won't be used because of the TryGetValue guard above, but needed by the API
            _ => ImmutableArray<LoreCallback>.Empty,
            (_, arr) => arr.Remove(callback));
    }

    internal static void HandleGlobalCallbackEvent(LoreEventFFI loreEvent, ulong userContext)
    {
        if (event_subscriptions_by_event_type.TryGetValue(loreEvent.Tag, out var callbacks)) {
            for (int i = 0; i < callbacks.Length; i++) {
                callbacks[i](loreEvent, userContext);
            }
        }
    }

    private sealed class Subscription : IDisposable
    {
        private Action? _dispose;
        public Subscription(Action dispose) => _dispose = dispose;
        public void Dispose() => Interlocked.Exchange(ref _dispose, null)?.Invoke();
    }
}
